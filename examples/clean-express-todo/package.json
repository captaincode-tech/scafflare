{
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "express": "^5.0.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "description": "stackforge-generated-clean backend generated by StackForge",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ]
  },
  "name": "stackforge-generated-clean",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev": "tsx watch src/server.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
