import express from "express";
{% if not ((architecture == "clean" and database == "sqlite") or architecture == "layered") %}
import type { NextFunction, Request, Response } from "express";
{% endif %}

import { env } from "./config/env.js";
{% if architecture == "clean" and database == "sqlite" %}
import { DrizzleTodoRepository } from "./database/drizzle-todo-repository.js";
import { db } from "./database/client.js";
import { TodoController } from "./modules/todos/controller.js";
import { createTodoRouter, errorHandler } from "./modules/todos/routes-express.js";
import { TodoService } from "./modules/todos/service.js";
{% elif architecture == "layered" %}
import { TodoController } from "./modules/todos/controller.js";
import { InMemoryTodoRepository } from "./modules/todos/repository.js";
import { createTodoRouter, layeredErrorHandler } from "./modules/todos/routes-express.js";
import { TodoService } from "./modules/todos/service.js";
{% endif %}
{% if pino_enabled %}
import { logger } from "./logger.js";
{% endif %}

export const app = express();
app.disable("x-powered-by");
app.use(express.json({ limit: "100kb" }));

app.get("/health", (_request, response) => {
  response.status(200).json({ status: "ok" });
});

{% if architecture == "clean" and database == "sqlite" %}
const todoRepository = new DrizzleTodoRepository(db);
const todoController = new TodoController(new TodoService(todoRepository));
app.use(createTodoRouter(todoController));
app.use(errorHandler);
{% elif architecture == "layered" %}
const todoRepository = new InMemoryTodoRepository();
const todoController = new TodoController(new TodoService(todoRepository));
app.use("/todos", createTodoRouter(todoController));
app.use(layeredErrorHandler);
{% else %}
app.use((_request: Request, response: Response) => {
  response.status(404).json({ error: "Not found" });
});
app.use((error: unknown, _request: Request, response: Response, _next: NextFunction) => {
  {% if pino_enabled %}logger.error({ error }, "Unhandled request error");{% else %}console.error(error);{% endif %}
  response.status(500).json({ error: "Internal server error" });
});
{% endif %}

let server: ReturnType<typeof app.listen> | undefined;

if (env.NODE_ENV !== "test") {
  server = app.listen(env.PORT, () => {
    {% if pino_enabled %}logger.info({ port: env.PORT }, "Server listening");{% else %}console.info(`Server listening on http://localhost:${env.PORT}`);{% endif %}
  });
}

function shutdown(signal: string): void {
  {% if pino_enabled %}logger.info({ signal }, "Shutting down");{% else %}console.info(`Received ${signal}; shutting down`);{% endif %}
  server?.close((error) => {
    if (error) {
      {% if pino_enabled %}logger.error({ error }, "Shutdown failed");{% else %}console.error(error);{% endif %}
      process.exitCode = 1;
    }
  });
}

process.once("SIGINT", () => shutdown("SIGINT"));
process.once("SIGTERM", () => shutdown("SIGTERM"));
