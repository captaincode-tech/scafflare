name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run typecheck
{% if biome_enabled %}      - run: npm run lint
{% endif %}{% if vitest_enabled %}      - run: npm test
{% endif %}      - run: npm run build
