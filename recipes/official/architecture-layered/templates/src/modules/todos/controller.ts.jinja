import type { CreateTodoInput, UpdateTodoInput } from "./domain.js";
import type { TodoService } from "./service.js";
export class TodoController { constructor(private readonly service:TodoService) {} list(){return this.service.list();} get(id:number){return this.service.get(id);} create(input:CreateTodoInput){return this.service.create(input);} update(id:number,input:UpdateTodoInput){return this.service.update(id,input);} delete(id:number){return this.service.delete(id);} }
