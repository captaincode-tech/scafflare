import { TodoNotFoundError, type CreateTodoInput, type Todo, type UpdateTodoInput } from "./domain.js";
import type { TodoRepository } from "./repository.js";
export class TodoService { constructor(private readonly repository:TodoRepository) {} list():Promise<Todo[]>{return this.repository.list();} async get(id:number){const todo=await this.repository.get(id);if(!todo)throw new TodoNotFoundError(id);return todo;} create(input:CreateTodoInput){const title=input.title.trim();if(!title)throw new Error("title must not be empty");return this.repository.create({title});} async update(id:number,input:UpdateTodoInput){const todo=await this.repository.update(id,input);if(!todo)throw new TodoNotFoundError(id);return todo;} async delete(id:number){if(!(await this.repository.delete(id)))throw new TodoNotFoundError(id);} }
