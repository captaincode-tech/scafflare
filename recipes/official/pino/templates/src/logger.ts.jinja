import pino from "pino";

import { env } from "./config/env.js";

const developmentTransport = env.NODE_ENV === "development"
  ? { target: "pino-pretty" as const, options: { colorize: true, singleLine: true } }
  : undefined;

export const logger = pino({
  level: env.LOG_LEVEL,
  ...(developmentTransport === undefined ? {} : { transport: developmentTransport }),
  base: { service: "{{ project_slug }}" },
  redact: ["req.headers.authorization", "password", "token"],
});
